    {
      "name": "Create refund - payment not refundable (declined)",
      "request": {
        "urlPathTemplate": "/payments/{paymentId}/refunds",
        "method": "POST",
        "customMatcher": {
          "name": "custom-and-matcher",
          "parameters": {
            "matchers": [
              {
                "name": "require-state",
                "parameters": {
                  "requirements": [
                    {
                      "key": "{{request.path.paymentId}}",
                      "absent": true,
                      "context": "refundable"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 409,
        "body": "{\n  \"error\": \"payment_not_refundable\",\n  \"message\": \"Payment was not successful and cannot be refunded\"\n}",
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "persistent": true,
      "priority": 2,
      "id": "075c9cef-481c-4662-a9f2-71a9a02167a3"
    },
    {
      "name": "Create refund (stateful, partial or full)",
      "request": {
        "urlPathTemplate": "/payments/{paymentId}/refunds",
        "method": "POST"
      },
      "response": {
        "status": 201,
        "body": "{{#formatJson}}\n  {{state refundId context='refunds'}}\n{{/formatJson}}",
        "headers": {
          "Content-Type": "application/json"
        },
        "transformers": [
          "response-template"
        ]
      },
      "persistent": true,
      "serveEventListeners": [
        {
          "name": "change-state",
          "parameters": {
            "operations": [
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "paymentId",
                "value": "{{request.path.paymentId}}"
              },
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "refundId",
                "value": "ref_{{randomValue type='ALPHANUMERIC' length=10 uppercase=false}}"
              },
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "payment",
                "value": "{{state paymentId context='payments'}}"
              },
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "paymentAmount",
                "value": "{{jsonPath payment '$.amount'}}"
              },
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "alreadyRefunded",
                "value": "{{jsonPath payment '$.amountRefunded'}}"
              },
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "newRefunded",
                "value": "{{math alreadyRefunded '+' (jsonPath request.body '$.amount')}}"
              },
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "exceeds",
                "value": "{{#if (gt (math newRefunded '-' paymentAmount) 0)}}yes{{else}}no{{/if}}"
              },
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "refundStatus",
                "value": "{{#eq exceeds 'yes'}}failed{{else}}succeeded{{/eq}}"
              },
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "failureReasonJson",
                "value": "{{#eq exceeds 'yes'}}\"amount_exceeds_refundable\"{{else}}null{{/eq}}"
              },
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "paymentStatus",
                "value": "{{#eq exceeds 'yes'}}{{jsonPath payment '$.status'}}{{else}}{{#eq newRefunded paymentAmount}}refunded{{else}}partially_refunded{{/eq}}{{/eq}}"
              },
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "finalRefunded",
                "value": "{{#eq exceeds 'yes'}}{{alreadyRefunded}}{{else}}{{newRefunded}}{{/eq}}"
              },
              {
                "context": "refunds",
                "operation": "SET",
                "phase": "AFTER_MATCH",
                "key": "{{refundId}}",
                "value": "{{#jsonMerge request.body}}\n{\n  \"id\": \"{{refundId}}\",\n  \"paymentId\": \"{{paymentId}}\",\n  \"currency\": \"{{jsonPath payment '$.currency'}}\",\n  \"status\": \"{{refundStatus}}\",\n  \"failureReason\": {{failureReasonJson}},\n  \"createdAt\": \"{{now}}\"\n}\n{{/jsonMerge}}"
              },
              {
                "context": "payment-{{paymentId}}-refunds",
                "operation": "SET",
                "phase": "AFTER_MATCH",
                "key": "{{refundId}}",
                "value": "{{state refundId context='refunds'}}"
              },
              {
                "context": "payments",
                "operation": "SET",
                "phase": "AFTER_MATCH",
                "key": "{{paymentId}}",
                "value": "{{#jsonMerge previousValue}}\n{\n  \"status\": \"{{paymentStatus}}\",\n  \"amountRefunded\": {{finalRefunded}}\n}\n{{/jsonMerge}}"
              }
            ]
          }
        }
      ],
      "postServeActions": [
        {
          "name": "webhook",
          "parameters": {
            "method": "POST",
            "url": "https://wc-echo.wiremockapi.cloud/webhook/echo",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": "{\n  \"id\": \"evt_{{randomValue type='ALPHANUMERIC' length=12 uppercase=false}}\",\n  \"type\": \"refund.{{refundStatus}}\",\n  \"createdAt\": \"{{now}}\",\n  \"data\": {{state refundId context='refunds'}}\n}"
          }
        }
      ],
      "id": "ed632a4a-45f3-4cd0-85b3-9dad7f271d41"
    },
    {
      "name": "List refunds for payment",
      "request": {
        "urlPathTemplate": "/payments/{paymentId}/refunds",
        "method": "GET"
      },
      "response": {
        "status": 200,
        "body": "{{#formatJson}}\n  [{{arrayJoin ',' (listState refundsContext)}}]\n{{/formatJson}}",
        "headers": {
          "Content-Type": "application/json"
        },
        "transformers": [
          "response-template"
        ]
      },
      "persistent": true,
      "serveEventListeners": [
        {
          "name": "change-state",
          "parameters": {
            "operations": [
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "refundsContext",
                "value": "payment-{{request.path.paymentId}}-refunds"
              }
            ]
          }
        }
      ],
      "id": "8e3d1225-c823-4558-aeb3-c3034bd356b0"
    },
