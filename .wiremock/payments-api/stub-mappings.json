    {
      "name": "Create payment (outcome driven by Test Cards data source)",
      "request": {
        "urlPathTemplate": "/payments",
        "method": "POST",
        "customMatcher": {
          "name": "custom-and-matcher",
          "parameters": {
            "matchers": [
              {
                "name": "data-exists",
                "parameters": {
                  "id": "xg9vr",
                  "matcherEnabled": true,
                  "query": "card_token = '{{jsonPath request.body '$.cardToken'}}'"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": "{{#formatJson}}\n  {{state paymentId context='payments'}}\n{{/formatJson}}",
        "headers": {
          "Content-Type": "application/json"
        },
        "transformers": [
          "response-template"
        ]
      },
      "persistent": true,
      "serveEventListeners": [
        {
          "name": "change-state",
          "parameters": {
            "operations": [
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "paymentId",
                "value": "pay_{{randomValue type='ALPHANUMERIC' length=10 uppercase=false}}"
              },
              {
                "context": "local",
                "operation": "REQUEST_VAR",
                "phase": "AFTER_MATCH",
                "key": "outcome",
                "value": "{{data.items.0.payment_status}}"
              },
              {
                "context": "payments",
                "operation": "SET",
                "phase": "AFTER_MATCH",
                "key": "{{paymentId}}",
                "value": "{{#jsonMerge request.body removeNulls=true}}\n{\n  \"id\": \"{{paymentId}}\",\n  \"status\": \"{{data.items.0.payment_status}}\",\n  \"responseCode\": \"{{data.items.0.response_code}}\",\n  \"responseMessage\": \"{{data.items.0.response_message}}\",\n  \"amountRefunded\": 0,\n  \"createdAt\": \"{{now}}\",\n  \"cardToken\": null\n}\n{{/jsonMerge}}"
              },
              {
                "context": "{{#eq outcome 'succeeded'}}refundable{{else}}not-refundable{{/eq}}",
                "operation": "SET",
                "phase": "AFTER_MATCH",
                "key": "{{paymentId}}",
                "value": "{\n  \"refundable\": true\n}"
              }
            ]
          }
        }
      ],
      "postServeActions": [
        {
          "name": "webhook",
          "parameters": {
            "method": "POST",
            "url": "https://wc-echo.wiremockapi.cloud/webhook/echo",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": "{\n  \"id\": \"evt_{{randomValue type='ALPHANUMERIC' length=12 uppercase=false}}\",\n  \"type\": \"{{data.items.0.webhook_event}}\",\n  \"createdAt\": \"{{now}}\",\n  \"data\": {{state paymentId context='payments'}}\n}"
          }
        }
      ],
      "id": "51c0ad03-cf56-4a9d-9c88-6c6a21386fef"
    },
