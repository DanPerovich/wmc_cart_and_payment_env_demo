# Copy to .env and fill in. `.env` is loaded by server.js on startup (real environment variables win).

# --- WireMock Cloud --------------------------------------------------------------------------
# WireMock Cloud API key (your account's security settings). Sent as `Authorization: Token <key>`.
# Used by "New demo" to reset the mock APIs' state and request logs, and by ./demo-setup.sh to provision
# the environment. Without it "New demo" only resets the page.
WMC_API_KEY=

# --- Webhooks --------------------------------------------------------------------------------
# The Payments mock delivers its webhooks to WEBHOOK_URL. DEFAULT: WireMock Cloud's free echo service,
# which replies with a copy of each request and stores nothing. You do not need to set anything.
#   WEBHOOK_URL=https://wc-echo.wiremockapi.cloud/webhook/echo
# The target is baked into the Payments mock's stubs, so after changing it re-run ./demo-setup.sh
# (it uses WEBHOOK_URL) or regenerate the stubs with tools/gen_stubs.py.
#
# OPTIONAL, webhook.site only: to list the events in the app's webhook panel and to enable the
# "Clear webhook.site log" button, point WEBHOOK_URL at your webhook.site address and set the API key
# below. Reading a webhook.site log through its API needs the key, which is a webhook.site
# paid-account feature. With any other target (including the echo service) the panel explains that
# events cannot be listed, and the clear button is hidden.
#   WEBHOOK_URL=https://webhook.site/<your-token-or-alias>
WEBHOOK_API_KEY=

# --- Demo mocks ---------------------------------------------------------------------------------
# These four are written into this file by ./demo-setup.sh (and removed again by ./demo-setup.sh
# --teardown), so you normally never edit them. There are deliberately NO built-in defaults: until they
# are set the app shows a notice telling you to run ./demo-setup.sh instead of calling any mock.
# PAYMENTS_URL=https://<your-environment>-payments.wiremockapi.cloud
# CART_URL=https://<your-environment>-cart.wiremockapi.cloud
# PAYMENTS_MOCK_API_ID=      # the mock APIs "New demo" resets (the original shared cart mock y09z4 is always refused)
# CART_MOCK_API_ID=

# --- Other optional overrides (defaults shown) -----------------------------------------------------
# PORT=8787
# WEBHOOK_TOKEN=                   # webhook.site token UUID; normally derived from WEBHOOK_URL
# WEBHOOK_API_BASE=https://webhook.site   # webhook.site API base (tests point this at a local fake)
# WMC_API_BASE=https://api.wiremock.cloud
